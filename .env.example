# Foothold Systems — environment variables
#
# Names only. Real values live in Vercel (Project → Settings → Environment
# Variables) and are marked Sensitive, so `vercel env pull .env.local` writes the
# names back with empty values for some of them — check the dashboard if a pulled
# variable comes through blank.
#
#   vercel env pull .env.local
#
# This file is committed. .env.local is not. Never put a value in here.

# ─── Lead routing: Google Sheets ─────────────────────────────────────────────
# The service account the sheet is shared with. Share the spreadsheet with this
# address as an Editor, or every append comes back 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, PEM. Stored with literal \n escapes; the
# code unescapes them on read. Paste it including the BEGIN/END lines.
GOOGLE_PRIVATE_KEY=
# Spreadsheet id — the long string in the sheet's URL between /d/ and /edit.
# The tab it writes to must be named exactly "Lead gen master".
GOOGLE_SHEET_ID=

# ─── Lead routing: Pushover ──────────────────────────────────────────────────
# User/group key from the Pushover dashboard — who gets the push.
PUSHOVER_USER_KEY=
# Application token, from the Pushover application registered for this site.
PUSHOVER_API_TOKEN=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend API key. Everything email goes through this: the guide, the sequence,
# the lead notification, and the alert below.
RESEND_API_KEY=
# Where a lead goes when the spreadsheet append fails. The full payload is
# emailed here so a lead is never dropped silently. Unset, it only reaches the
# function logs.
ALERT_EMAIL=

# ─── Already in use elsewhere in this app ────────────────────────────────────
# Resend audience the lead magnet enrols people into (src/lib/subscribe.ts).
RESEND_AUDIENCE_ID=
# Overrides for the notification destination and the verified sender.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Neon Postgres. Consent records, rate limiting and the CRO engine. Any one of
# DATABASE_URL / STORAGE_DATABASE_URL / NEON_DATABASE_URL / POSTGRES_URL /
# STORAGE_POSTGRES_URL is read, first one found wins.
DATABASE_URL=
# Basic-auth password for /admin and for GET /api/lead/health. Fails shut:
# unset means nothing is authorised.
ADMIN_PASSWORD=
# Canonical origin, used to build absolute links in outgoing email.
NEXT_PUBLIC_SITE_URL=
# Meta Pixel id. No pixel renders without it — there is deliberately no default,
# because a wrong id looks identical to a working one and files conversions into
# somebody else's account. Set in Production only: a preview deployment firing
# PageView into the live pixel is noise in the data ads optimise against.
# Baked in at build time, so a change here needs a redeploy to take effect.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token, from Events Manager > Settings > Conversions API >
# Generate access token. Server-side only — never prefixed NEXT_PUBLIC_, since
# it can write events to your pixel.
#
# Optional: with it unset the browser pixel still fires and nothing errors, you
# just lose the events that ad blockers and iOS suppress, which on paid traffic
# is a meaningful share. Both transports send a shared event_id so Meta
# deduplicates them rather than counting each sale twice.
META_CAPI_ACCESS_TOKEN=
# Graph API version for the Conversions API. Defaults to v25.0; bump when Meta
# retires it (they support each for roughly two years).
META_GRAPH_API_VERSION=
# ─── Free AI visibility scan ─────────────────────────────────────────────────
# Scans run through Is Agentic (https://is-agentic.com), Vercel's front end to
# Ora's scanner, because Ora's own endpoint allows only 30 scans per rolling 24
# hours per IP — and on Vercel that IP is shared across every visitor. Is
# Agentic proxies the same scanner with no daily ceiling. Keyless; this is only
# here so it can be pointed at a staging host.
IS_AGENTIC_BASE_URL=
# Ora agent-readiness API (https://ora.ai/docs), now the fallback underneath Is
# Agentic. Reads are keyless, so the scan works with none of these set — the
# base URL is only here so the API can be pointed at a staging host. The key is
# worth setting if Ora ever issues you one: holders are exempt from the scan
# rate limits entirely, which would make the fallback as unmetered as the
# primary.
ORA_API_BASE_URL=
ORA_API_KEY=
# Whop account API key, server-side only. Checkouts are created through the API
# rather than as static dashboard links, because only an API-created checkout can
# carry the metadata that ties a payment back to a report.
# Needs exactly five permissions: checkout_configuration:create, plan:create,
# access_pass:create, access_pass:update, checkout_configuration:basic:read.
# Nothing under Payouts, Members or Company.
WHOP_API_KEY=
# The biz_... company id the plans are created under.
WHOP_ACCOUNT_ID=
# Signing secret for the Whop webhook (POST /api/whop/webhook). The ws_ string
# from the webhook's page in the Whop dashboard, stored whole: do not strip the
# prefix and do not re-encode it. FAILS SHUT: with this unset every webhook is
# rejected, so no payment can ever unlock a report.
WHOP_WEBHOOK_SECRET=
# Shared secret for the scan recovery cron (GET /api/scan/sweep). Vercel Cron
# sends it as a bearer token. FAILS SHUT: unset means the sweeper is closed to
# everyone, including Vercel.
CRON_SECRET=
